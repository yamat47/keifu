{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keifu",
  "main": "./worker/index.ts",
  // 同梱の workerd がサポートする日付まで。これより先にすると miniflare が起動しない
  "compatibility_date": "2026-07-22",

  // SPA。静的アセットに一致しないパスだけが Worker に届く
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // database_id はローカルでは SQLite ファイルの識別子でしかない。
  // 空にすると miniflare が起動しないので仮の値を置く。
  // Cloudflare アカウントを作る Phase 5 で実際の UUID に差し替える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keifu",
      "database_id": "keifu-local-placeholder",
      "migrations_dir": "./migrations"
    }
  ]
}
